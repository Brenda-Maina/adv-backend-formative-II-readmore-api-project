@baseUrl = http://localhost:3000
@fakeId = 64b7f0c2a1b2c3d4e5f60718

### 01 Health check (200)
GET {{baseUrl}}/

### 02 Create author 1 (201)
# @name author1
POST {{baseUrl}}/authors
Content-Type: application/json

{
  "name": "Chinua Achebe",
  "country": "Nigeria",
  "bio": "Nigerian novelist."
}

### 03 Create author 2 (201)
# @name author2
POST {{baseUrl}}/authors
Content-Type: application/json

{
  "name": "Ngugi wa Thiong'o",
  "country": "Kenya",
  "bio": "Kenyan writer."
}

### 04 Create author 3, will have no books (201)
# @name author3
POST {{baseUrl}}/authors
Content-Type: application/json

{
  "name": "Author Without Books",
  "country": "Rwanda"
}

### 05 Get all authors (200)
GET {{baseUrl}}/authors

### 06 Get one author (200)
GET {{baseUrl}}/authors/{{author1.response.body.$._id}}

### 07 Update author (200)
PUT {{baseUrl}}/authors/{{author1.response.body.$._id}}
Content-Type: application/json

{
  "bio": "Nigerian novelist, poet and critic."
}

### 08 Author id that does not exist (404)
GET {{baseUrl}}/authors/{{fakeId}}

### 09 Create book 1 (201, author populated)
# @name book1
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "The Silent Sea",
  "genre": "Thriller",
  "price": 24.99,
  "publishedYear": 2021,
  "author": "{{author1.response.body.$._id}}"
}

### 10 Create book 2 (201)
# @name book2
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Echoes of Dawn",
  "genre": "Drama",
  "price": 12.5,
  "publishedYear": 2019,
  "author": "{{author1.response.body.$._id}}"
}

### 11 Create book 3 (201)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Sea of Secrets",
  "genre": "Thriller",
  "price": 29.99,
  "publishedYear": 2015,
  "author": "{{author2.response.body.$._id}}"
}

### 12 Create book 4 (201)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Night Train",
  "genre": "Thriller",
  "price": 45,
  "publishedYear": 2020,
  "author": "{{author2.response.body.$._id}}"
}

### 13 Get all books (200, authors populated, paginated)
GET {{baseUrl}}/books

### 14 Get one book (200)
GET {{baseUrl}}/books/{{book1.response.body.$._id}}

### 15 Update book (200)
PUT {{baseUrl}}/books/{{book2.response.body.$._id}}
Content-Type: application/json

{
  "price": 14
}

### 16 All books by author 1 (200)
GET {{baseUrl}}/authors/{{author1.response.body.$._id}}/books

### 17 RULE 1: author does not exist (400)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Ghost Book",
  "genre": "Horror",
  "price": 10,
  "publishedYear": 2020,
  "author": "{{fakeId}}"
}

### 18 RULE 2: duplicate title, same author, different case (409)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "the silent sea",
  "genre": "Thriller",
  "price": 20,
  "publishedYear": 2020,
  "author": "{{author1.response.body.$._id}}"
}

### 19 RULE 2: same title, different author is allowed (201)
# @name book5
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "The Silent Sea",
  "genre": "Mystery",
  "price": 15,
  "publishedYear": 2022,
  "author": "{{author2.response.body.$._id}}"
}

### 20 RULE 3: price is zero (422)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Free Book",
  "genre": "Drama",
  "price": 0,
  "publishedYear": 2020,
  "author": "{{author1.response.body.$._id}}"
}

### 21 RULE 3: year in the future (422)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Future Book",
  "genre": "Drama",
  "price": 10,
  "publishedYear": 2999,
  "author": "{{author1.response.body.$._id}}"
}

### 22 RULE 3: year before 1450 (422)
POST {{baseUrl}}/books
Content-Type: application/json

{
  "title": "Ancient Book",
  "genre": "Drama",
  "price": 10,
  "publishedYear": 1200,
  "author": "{{author1.response.body.$._id}}"
}

### 23 RULE 5: combined filters (200, 2 books, cheapest first)
GET {{baseUrl}}/books?genre=Thriller&minPrice=10&maxPrice=30&search=sea&sort=price&order=asc

### 24 RULE 5: only genre (200)
GET {{baseUrl}}/books?genre=thriller

### 25 CHALLENGE: pagination (200)
GET {{baseUrl}}/books?page=1&limit=2

### 26 RULE 5: invalid sort field (400)
GET {{baseUrl}}/books?sort=colour

### 27 Delete a book (200)
DELETE {{baseUrl}}/books/{{book5.response.body.$._id}}

### 28 That book is gone (404)
GET {{baseUrl}}/books/{{book5.response.body.$._id}}

### 29 RULE 6: stats for author 1 (200)
GET {{baseUrl}}/authors/{{author1.response.body.$._id}}/stats

### 30 RULE 6: stats for author with no books (200, no crash)
GET {{baseUrl}}/authors/{{author3.response.body.$._id}}/stats

### 31 RULE 4: delete author who still has books (409)
DELETE {{baseUrl}}/authors/{{author1.response.body.$._id}}

### 32 Delete author with no books (200)
DELETE {{baseUrl}}/authors/{{author3.response.body.$._id}}
